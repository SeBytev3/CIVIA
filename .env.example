# Copiar a .env (NUNCA versionar valores reales)
POSTGRES_DB=civia
POSTGRES_USER=civia
POSTGRES_PASSWORD=local_dev_change_me
DATABASE_URL=postgresql://civia:local_dev_change_me@db:5432/civia
GOOGLE_API_KEY_PRIMARY=
GOOGLE_API_KEY_SECONDARY=
GROQ_API_KEY=
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=qwen/qwen3.8-27b
AI_TERTIARY_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOKENS=6000
FALLA_FORZADA=
AUTO_SEED_SYNTHETIC=true
# Credencial administrativa obligatoria generada localmente con CSPRNG por instalación (sin valor predeterminado ni modo demo).
# Procedimiento estándar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Política: formato URL-safe base64 (>=32 caracteres, >=12 símbolos distintos, sin secuencias, repeticiones ni palabras contextuales/demo).
# Nota: los filtros del servidor bloquean patrones previsibles, pero no pueden demostrar matemáticamente la aleatoriedad de una cadena arbitraria.
ADMIN_TOKEN=

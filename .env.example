# Los scripts run inicializan .env con secretos aleatorios. Conservar .env fuera de Git.
POSTGRES_DB=civia
POSTGRES_USER=civia
POSTGRES_PASSWORD=
# Credencial propietaria. Solo la recibe el servicio de migración.
DATABASE_URL=
APP_DATABASE_URL=
AGENT_DATABASE_URL=
WORKER_DATABASE_URL=
ADMIN_TOKEN=
GOOGLE_API_KEY_PRIMARY=
GROQ_API_KEY=
# Preservar los modelos configurados hasta validarlos explícitamente con la cuenta.
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=qwen/qwen3.8-27b
AI_GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_GROQ_AUDIO_MODEL=whisper-large-v3-turbo
AI_TIMEOUT_SECONDS=15
AI_PROVIDER_RPM=12
AI_PROVIDER_TPM=120000
AI_DAILY_REQUESTS=300
AI_DAILY_TOKENS=1800000
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOKENS=6000
AUTO_SEED_SYNTHETIC=true
AUTH_COOKIE_SECURE=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost
# Los puertos HTTP siempre se publican en loopback.
CIVIA_API_PORT=8000
CIVIA_HTTP_PORT=5173
# HTTPS sólo se publica en la interfaz elegida por el modo LAN.
CIVIA_HTTPS_PORT=5443
# Los cuatro valores deben definir la misma red y una IP reservada para Nginx.
CIVIA_SUBNET=172.28.0.0/16
CIVIA_GATEWAY=172.28.0.1
CIVIA_DYNAMIC_RANGE=172.28.1.0/24
CIVIA_FRONTEND_IP=172.28.0.2

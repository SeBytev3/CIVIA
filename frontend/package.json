{
  "name": "civia-frontend",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "node e2e/test_roles.cjs",
    "test:pwa-install": "node e2e/test_pwa_install.cjs",
    "build:android": "tsc -b && vite build --mode android",
    "sync:android": "npm run build:android && cap sync android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@capacitor/geolocation": "7.1.8",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
